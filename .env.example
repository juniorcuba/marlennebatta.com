# Copia este archivo a .env.local para desarrollo. Nunca subas .env* reales.

# URL pública del sitio (canonical, OG, sitemap). Vacía = https://marlenebatta.com
NEXT_PUBLIC_SITE_URL=

# "false" solo en el despliegue definitivo: mientras tanto, el sitio no se indexa.
NEXT_PUBLIC_NOINDEX=true

# Correo de las solicitudes (preferido). El correo del dominio está en GoDaddy.
SMTP_HOST=smtpout.secureserver.net
SMTP_PUERTO=465
SMTP_USUARIO=mb@marlenebatta.com
# La contraseña del buzón va SOLO en el panel de Render, nunca en el repo.
SMTP_CONTRASENA=
# Quién recibe las solicitudes. Vacío = mb@marlenebatta.com
CORREO_DESTINO=

# Alternativa si no hay SMTP: destino de las solicitudes de agenda (p. ej. un webhook de n8n). Sin ella, el
# formulario valida pero responde que la agenda en línea aún no está activa.
SOLICITUD_WEBHOOK_URL=
# Se manda en la cabecera X-Webhook-Secret: el receptor debe rechazar lo que no lo traiga.
SOLICITUD_WEBHOOK_SECRETO=
